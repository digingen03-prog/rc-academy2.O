# API Environment Configuration Template
NODE_ENV=development
PORT=4000
ACADEMY_TIMEZONE=Asia/Kolkata

# Database (PostgreSQL)
DATABASE_URL="postgresql://rca_admin:rca_dev_password_change_me@localhost:5432/rca2_db?schema=public"

# Authentication & JWT
JWT_SECRET="replace-with-a-very-strong-random-secret-key-in-production-32-chars-min"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="replace-with-a-separate-strong-refresh-secret-in-production"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="rca_redis_dev_secret"

# Storage
STORAGE_DRIVER="local" # local | s3
STORAGE_LOCAL_ROOT="./storage/uploads"
MAX_UPLOAD_SIZE_MB=25

# Internal AI Service Access
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_TOKEN="rca_internal_ai_token_secret_replace_me"

# Logging & Observability
LOG_LEVEL="debug"
